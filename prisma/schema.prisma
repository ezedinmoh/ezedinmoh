generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  description        String
  image              String          @default("")
  screenshots        String[]        @default([])
  tags               String[]
  stack              String[]
  category           String[]
  liveUrl            String?
  githubUrl          String?
  featured           Boolean         @default(false)
  year               String
  sortOrder          Int             @default(0)
  featuredSortOrder  Int             @default(0)
  previewMode        String          @default("slideshow")
  caseStudyProblem   String?
  caseStudySolution  String?
  caseStudyOutcome   String?
  ratingSum          Int             @default(0)
  ratingCount        Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  ratings            ProjectRating[]

  @@map("projects")
}

model ProjectRating {
  id        String   @id @default(cuid())
  projectId String
  rating    Int
  userIp    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userIp])
  @@map("project_ratings")
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  avatar    String   @default("")
  reactions Json     @default("{}")
  pinned    Boolean  @default(false)
  hostReply String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guestbook_entries")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  path       String
  referrer   String?
  deviceType String
  country    String?
  createdAt  DateTime @default(now())

  @@map("analytics_events")
}

model Resume {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("resume")
}

model Profile {
  id               String   @id @default("singleton")
  avatarUrl        String   @default("")
  coverImageUrl    String   @default("")
  title            String   @default("Ezedin Mohammed")
  location         String   @default("Kombolcha, Ethiopia")
  yearsExperience  String   @default("5+ Years Experience")
  bio              String   @default("")
  stats            Json?
  experiences      Json?
  timeline         Json?
  funFacts         Json?
  workStyle        Json?
  interests        Json?
  updatedAt        DateTime @updatedAt

  @@map("profile")
}
